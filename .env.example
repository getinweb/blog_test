COMPOSE_PROJECT_NAME=blog_test
HTTP_PORT=8080

APP_ENV=dev
# 0 or 1; process environment values override app/config defaults.
APP_DEBUG=1
APP_TIMEZONE=UTC

DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=blog
# Development credentials only. MySQL reads these when initializing an empty volume.
DB_PASSWORD=blog_dev
MYSQL_ROOT_PASSWORD=blog_root_dev

ARTICLES_PER_PAGE=12

# Maximum image file size in bytes (5 MiB).
IMAGE_MAX_BYTES=5242880
